# Campus Connect Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Free Cloud Database Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_connect?retryWrites=true&w=majority

# Local fallback (if you have MongoDB Community Server installed locally)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect

# JWT Secret for student authentication tokens
JWT_SECRET=campus_connect_secret_key_2026_iiitv_icd

